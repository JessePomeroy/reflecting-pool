# ============================================================================
# reflecting-pool — Environment Variables
# ============================================================================
# Copy this file to .env.local (for dev) and set real values.
# NEVER commit a file named .env or .env.production with real secrets.
# `.gitignore` already excludes .env*, but the generic filename is a footgun.
#
# In production, all of these must be set in Vercel → Settings → Environment
# Variables AND in Convex → `npx convex env set <NAME> <VALUE>` (for the subset
# read by Convex functions, marked [convex] below).
# ============================================================================

# ----- Site -----
PUBLIC_SITE_URL=http://localhost:5173

# ----- Convex -----
# Shared Convex deployment consumed by this spoke. Convex CLI/schema work lives
# in ../angelsrest/packages/crm-api, not this repository.
PUBLIC_CONVEX_URL=https://your-deployment-slug.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://your-deployment-slug.convex.site

# ----- Better Auth [convex] -----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
AUTH_SECRET=
# Must match the deployed site's URL (used by the auth handler to build callback URLs)
SITE_URL=http://localhost:5173
# Google OAuth (Better Auth social provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ----- Webhook auth [convex] -----
# Shared secret between the SvelteKit webhook handlers and the Convex
# mutations they call. Gates orders.create / orders.updateStatus /
# platform.updateSubscription / platform.getBySubscriptionId /
# invoices.markPaid.
# Generate with: openssl rand -base64 32
# ALSO run: npx convex env set WEBHOOK_SECRET <value>
WEBHOOK_SECRET=

# ----- Sanity CMS -----
# Public Sanity project info is enough for published content reads.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production
# Server-only aliases are also supported for deployments that prefer not to
# expose project metadata as public env vars.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
# Optional read token for private datasets. Leave empty for public published reads.
SANITY_API_READ_TOKEN=
# Optional preview token for future draft preview support. Not used by runtime yet.
SANITY_API_PREVIEW_TOKEN=

# ----- Stripe checkout bridge -----
# Stripe platform keys and the Stripe webhook live on Angels Rest. This site
# validates catalog/pricing locally, then signs a server-to-server request to
# the hub checkout bridge.
CHECKOUT_BRIDGE_URL=https://angelsrest.online/api/tenant-checkout/print
CHECKOUT_BRIDGE_SECRET=
# Migration target for this existing spoke. The runtime defaults to "spoke" if
# omitted so code can deploy before the live Stripe endpoint is verified. Set
# to "hub" only after Stripe sends connected-account commerce events to Angels
# Rest; an unexpected local checkout event will then fail with no side effects.
STRIPE_COMMERCE_WEBHOOK_OWNER=hub

# ----- Resend (transactional email) -----
RESEND_API_KEY=
# Email addresses for order notifications. Required in production.
ADMIN_EMAIL=
FROM_EMAIL=

# ----- LumaPrints (print fulfillment) -----
LUMAPRINTS_API_KEY=
LUMAPRINTS_API_SECRET=
LUMAPRINTS_STORE_ID=
# Set to "true" to route all LumaPrints API calls through the sandbox endpoint.
LUMAPRINTS_USE_SANDBOX=true
# Webhook verification. Use either HMAC signing or a shared token
# — either is enough to pass `verifyCaller` in the webhook handler.
# Generate with: openssl rand -base64 32
LUMAPRINTS_WEBHOOK_SIGNING_SECRET=
LUMAPRINTS_WEBHOOK_SECRET=

# ----- Gallery Worker (Cloudflare Worker for R2 uploads) -----
# Per-tenant Worker instance. Defaults to the creator's worker in dev;
# required (fail-closed) in prod.
GALLERY_WORKER_URL=https://gallery-worker.your-subdomain.workers.dev
# Secret used to authenticate admin upload / presign requests to the worker.
# Rotate separately per repo — this is NOT the same as angelsrest's copy.
GALLERY_ADMIN_SECRET=

# ----- Sentry -----
# Optional. Leave empty to disable error capture entirely (no-op).
# Source-map upload needs the auth token in CI, not the runtime environment.
PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
